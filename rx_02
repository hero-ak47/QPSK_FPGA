%% SECTION 1: BẮT ĐẦU THU TÍN HIỆU
disp('Đang ghi âm... Hãy phát tín hiệu ở máy kia.');
r = audiorecorder(48000, 24, 1);
record(r);

%% SECTION 2: DỪNG THU VÀ XỬ LÝ TÍN HIỆU
stop(r);
disp('Đã dừng ghi âm. Đang xử lý tín hiệu...');
y = getaudiodata(r, 'double');
plot(y);

% 1. THÔNG SỐ VÀ TÁI TẠO PREAMBLE LÀM CHUẨN MẪU
Fs = 48000; Fc = 10000; Rs = 400; L = Fs/Rs;
beta = 0.5; span = 6;
h_rrc = rcosdesign(beta, span, L, 'sqrt');

CFO_true = 3.1 ;  SNR_dB = 25;
h_ch_audio = 1;
y = conv(y, h_ch_audio);
y = y .* exp(1j*2*pi*CFO_true*(0:length(y)-1)'/Fs);


Nzc = 63;
u   = 25;
Lsym = Nzc * L;              % số mẫu của MỘT khối preamble ZC sau pulse shaping
n   = (0:Nzc-1).';
pss = exp(-1j*pi*u*n.*(n+1)/Nzc);

% Tái tạo lại chính xác chuỗi Preamble ở máy thu để cross-correlation
preamble_sym_rx = pss;
preamble_bb_ideal = upfirdn(preamble_sym_rx, h_rrc, L);

% 2. TIỀN XỬ LÝ: LỌC BĂNG THÔNG & HẠ TẦN XUỐNG BASEBAND
% Lọc Bandpass từ 11kHz đến 13kHz để loại bỏ tạp âm phòng học
[b, a] = butter(4, [9000 11000]/(Fs/2), 'bandpass');
y_filt = filter(b, a, y);

% Hạ tần số sóng mang (Down-conversion)
t_rx = (0:length(y_filt)-1)' / Fs;
y_bb = y_filt .* exp(-1j * 2 * pi * Fc * t_rx);

% Matched Filter (Lọc bằng đúng bộ lọc RRC đã dùng ở máy phát)
y_mf = conv(y_bb, h_rrc, 'same');

% 3. ĐỒNG BỘ KHUNG (FRAME SYNCHRONIZATION)
[xc, lags] = xcorr(y_mf, preamble_bb_ideal);
[peak_val, max_idx] = max(abs(xc));
start_sample = lags(max_idx) + 1;

noise_floor = median(abs(xc));
fprintf('\n--- DEBUG: FRAME SYNC ---\n');
fprintf('start_sample = %d (length y_mf = %d)\n', start_sample, length(y_mf));
fprintf('Peak xcorr = %.4f | Noise floor (median) = %.6f | Peak/Noise = %.2f\n', ...
        peak_val, noise_floor, peak_val/noise_floor);
if peak_val/noise_floor < 5
    warning('Peak/Noise thấp -> có thể sync SAI vị trí, kết quả downstream không đáng tin!');
end

Nguard = 14;
Npayload = 500;
skip = Nzc + Nguard;
total_sym_len = skip + Npayload;
fprintf('skip = %d, total_sym_len = %d\n', skip, total_sym_len);

if start_sample < 1 || (start_sample + total_sym_len*L) > length(y_mf)
    error('Không tìm thấy khung tín hiệu nguyên vẹn. Hãy thử thu phát lại!');
end

% 4. TRÍCH XUẤT SYMBOL (DOWNSAMPLING)
rx_symbols = zeros(total_sym_len, 1);
first_sym_offset = (span*L/2) + 1;

for k = 1:total_sym_len
    idx = start_sample + first_sym_offset + (k-1)*L - 1;
    rx_symbols(k) = y_mf(idx);
end

fprintf('\n--- DEBUG: EXTRACTED SYMBOLS ---\n');
fprintf('5 preamble symbols đầu (nên có |.| tương đối đều, gần 1 nếu preamble chuẩn):\n');
disp(abs(rx_symbols(1:5)).');
fprintf('5 symbol đầu payload (sau preamble+guard):\n');
disp(rx_symbols(skip+1:skip+5).');

% 5. ƯỚC LƯỢNG & BÙ CFO (LEAST SQUARES)
rx_payload = rx_symbols(skip+1:end);

pilot_indices = 1:5:500;
data_indices  = setdiff(1:500, pilot_indices);
pilot_sym_ideal = 1 + 1j;

% ----- 5a. Ước lượng CFO bằng LS -----
rx_pilots_raw = rx_payload(pilot_indices);
pilot_phase_raw = angle(rx_pilots_raw ./ pilot_sym_ideal);

fprintf('\n--- DEBUG: PILOT PHASE (TRƯỚC UNWRAP) ---\n');
fprintf('pilot_phase_raw (rad):\n');
disp(pilot_phase_raw(1:min(10,end)).');
fprintf('Nếu các giá trị này KHÔNG có xu hướng tuyến tính rõ -> sync/preamble có vấn đề.\n');

pilot_phase_unwrapped = unwrap(pilot_phase_raw);
fprintf('pilot_phase_unwrapped (rad):\n');
disp(pilot_phase_unwrapped(1:min(10,end)).');

idx_col = pilot_indices(:) - 1;   % 0-based, khớp với n_idx bên dưới
A = [ones(length(idx_col),1), idx_col];
coeffs = A \ pilot_phase_unwrapped;
slope  = coeffs(2);

Tsym = L / Fs;
cfo_est = slope / (2*pi*Tsym);

fprintf('\n--- DEBUG: CFO ESTIMATION ---\n');
fprintf('slope (rad/symbol) = %.6f\n', slope);
fprintf('phi0  (rad)        = %.6f\n', coeffs(1));
fprintf('CFO ước lượng      = %.4f Hz\n', cfo_est);

% Kiểm tra residual sau fit (đo độ khớp của LS)
phase_fit = A * coeffs;
residual = pilot_phase_unwrapped - phase_fit;
fprintf('RMS residual sau LS fit = %.6f rad (càng gần 0 càng tốt)\n', sqrt(mean(residual.^2)));

% ----- 5b. Bù CFO -----
n_idx = (0:499).';
cfo_correction = exp(-1j * 2*pi * cfo_est * Tsym * n_idx);
rx_payload_cfo = rx_payload .* cfo_correction;

pilot_phase_after = angle(rx_payload_cfo(pilot_indices) ./ pilot_sym_ideal);
fprintf('\n--- DEBUG: PILOT PHASE (SAU KHI BÙ CFO) ---\n');
fprintf('pilot_phase_after (rad, nên dao động quanh 0, KHÔNG còn xu hướng trôi):\n');
disp(pilot_phase_after(1:min(10,end)).');

% ----- 5c. Ước lượng kênh -----
rx_pilots = rx_payload_cfo(pilot_indices);
H_est = rx_pilots ./ pilot_sym_ideal;

fprintf('\n--- DEBUG: CHANNEL ESTIMATION ---\n');
fprintf('|H_est| tại pilot (nên tương đối ổn định nếu kênh phẳng):\n');
disp(abs(H_est(1:min(10,end))).');
fprintf('angle(H_est) tại pilot (rad):\n');
disp(angle(H_est(1:min(10,end))).');

H_interp = interp1(pilot_indices, H_est, 1:500, 'linear', 'extrap').';

% ----- 5d. Cân bằng kênh -----
rx_payload_eq = rx_payload_cfo ./ H_interp;
rx_data_eq = rx_payload_eq(data_indices);

fprintf('\n--- DEBUG: SAU EQUALIZE ---\n');
fprintf('5 data symbol đầu sau equalize (nên gần {±1±1j}):\n');
disp(rx_data_eq(1:5).');

% 6. GIẢI ĐIỀU CHẾ QPSK VÀ SO SÁNH
rx_bits = zeros(length(rx_data_eq)*2, 1);
rx_bits(1:2:end) = real(rx_data_eq) < 0;
rx_bits(2:2:end) = imag(rx_data_eq) < 0;

rng(123);
tx_data_bits_ideal = randi([0 1], 400 * 2, 1);

num_errors = sum(rx_bits ~= tx_data_bits_ideal);
BER = num_errors / length(tx_data_bits_ideal);

fprintf('\n--- DEBUG: BIT COMPARE (20 bit đầu) ---\n');
fprintf('rx_bits          : '); disp(rx_bits(1:20).');
fprintf('tx_data_bits_ideal: '); disp(tx_data_bits_ideal(1:20).');

% 7. HIỂN THỊ KẾT QUẢ
disp('--- KẾT QUẢ TRUYỀN NHẬN ---');
fprintf('Số bits truyền: %d\n', length(tx_data_bits_ideal));
fprintf('Số bits lỗi: %d\n', num_errors);
fprintf('Tỉ lệ lỗi bit (BER): %f\n', BER);

figure;
scatter(real(rx_data_eq), imag(rx_data_eq), 'b.'); hold on;
scatter([1 -1 1 -1], [1 1 -1 -1], 'rx', 'LineWidth', 2);
title('Chòm sao tín hiệu nhận được (Đã qua cân bằng kênh)');
xlabel('In-phase'); ylabel('Quadrature');
grid on; axis square;
